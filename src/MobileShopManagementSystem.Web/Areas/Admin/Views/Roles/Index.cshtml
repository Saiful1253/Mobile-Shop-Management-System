@model List<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    Layout = "_Layout";
}

<div class="content">
    <div class="page-header">
        <h1>Role Management</h1>
        <a asp-action="Create" class="btn">Create New Role</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table>
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Role ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Id</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@role.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this role?');">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
