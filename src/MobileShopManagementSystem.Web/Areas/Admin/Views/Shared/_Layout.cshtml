@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>
        <a asp-controller="Brands" asp-action="Index">Brands</a>
        <a asp-controller="Categories" asp-action="Index">Categories</a>
        <a asp-controller="Products" asp-action="Index">Products</a>
        <a asp-controller="Customers" asp-action="Index">Customers</a>
        <a asp-controller="Suppliers" asp-action="Index">Suppliers</a>
        <a asp-controller="Roles" asp-action="Index">Roles</a>
        <a asp-controller="Purchases" asp-action="Index">Purchases</a>
        <a asp-controller="Sales" asp-action="Index">Sales</a>
        <a asp-controller="Reports" asp-action="InventoryReport">Reports</a>
        <form asp-controller="Account" asp-action="LogOff" method="post">
            <button type="submit">Logout</button>
        </form>
    </nav>
    <div class="content">
        @RenderBody()
    </div>
</body>
</html>
