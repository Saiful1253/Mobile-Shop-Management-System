@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Customer Portal</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
        <form asp-controller="Account" asp-action="LogOff" method="post">
            <button type="submit">Logout</button>
        </form>
    </nav>
    <div class="content">
        @RenderBody()
    </div>
</body>
</html>
