@model MobileShopManagementSystem.Web.Models.LoginViewModel
@{
    Layout = "_Layout";
}
<div class="login-container">
    <h2>Admin Login</h2>
    <p>Sign in with your admin account</p>
    <form asp-action="AdminLogin" method="post" class="login-form">
        <div asp-validation-summary="All"></div>
        <input asp-for="Email" placeholder="Email address" />
        <input asp-for="Password" placeholder="Password" type="password" />
        <label>
            <input asp-for="RememberMe" type="checkbox" /> Remember me
        </label>
        <button type="submit">Sign In</button>
    </form>
    <a asp-action="Login">Back to Login</a>
</div>
