@{
    Layout = null;
    ViewData["Title"] = "Welcome - Mobile Shop MS";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; }
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            padding: 2rem;
        }
        .login-card {
            background: #fff;
            border-radius: 1rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 520px;
            overflow: hidden;
        }
        .login-card-header {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            color: #fff;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
        }
        .login-card-header .logo-icon {
            width: 64px;
            height: 64px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }
        .login-card-header .logo-icon i { font-size: 2rem; }
        .login-card-header h2 { color: #fff; margin-bottom: 0.35rem; font-weight: 700; }
        .login-card-header p { color: rgba(255,255,255,0.85); margin: 0; font-size: 0.9rem; }
        .login-card-body { padding: 2rem; }
        .role-card {
            border: 2px solid #e2e8f0;
            border-radius: 0.75rem;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .role-card:hover {
            border-color: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.15);
            color: inherit;
        }
        .role-card i {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
            display: block;
        }
        .role-card h5 {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .role-card p {
            margin: 0;
            font-size: 0.85rem;
            color: #64748b;
        }
        .role-admin i { color: #4f46e5; }
        .role-customer i { color: #059669; }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-card-header">
                <div class="logo-icon"><i class="bi bi-phone"></i></div>
                <h2>Mobile Shop MS</h2>
                <p>Select your role to continue</p>
            </div>
            <div class="login-card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <a asp-controller="Account" asp-action="AdminLogin" class="role-card role-admin">
                            <i class="bi bi-shield-lock"></i>
                            <h5>Admin</h5>
                            <p>Manage shop</p>
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Account" asp-action="CustomerLogin" class="role-card role-customer">
                            <i class="bi bi-person-circle"></i>
                            <h5>Customer</h5>
                            <p>Browse & buy</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
