@model MobileShopManagementSystem.Web.Models.LoginViewModel
@{
    Layout = "_Layout";
    var tab = ViewData["Tab"] as string ?? "staff";
}
<div class="login-wrapper">
    <div class="login-card">
        <div class="login-tabs">
            <a asp-action="Login" asp-controller="Account" asp-route-tab="staff" class="tab-btn @(tab == "staff" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                Staff Terminal
            </a>
            <a asp-action="Login" asp-controller="Account" asp-route-tab="customer" class="tab-btn @(tab == "customer" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                Customer Portal
            </a>
        </div>

        <div class="login-header">
            <div class="lock-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <h2>@(tab == "staff" ? "Staff Terminal Login" : "Customer Portal Login")</h2>
            <p>@(tab == "staff" ? "POS, Inventory, Repair Workbench & Admin Portal Access" : "Order history, support & service tracking")</p>
        </div>

        @if (tab == "staff")
        {
            <div class="demo-fill">
                <div class="demo-label">Role User</div>
                <div class="demo-cards">
                    <div class="demo-card" onclick="fillDemo('admin')">
                        <div class="demo-role">ADMIN</div>
                    </div>
                    <div class="demo-card" onclick="fillDemo('sales')">
                        <div class="demo-role">SALES</div>
                    </div>
                    <div class="demo-card" onclick="fillDemo('tech')">
                        <div class="demo-role">TECHNICIAN</div>
                    </div>
                </div>
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" class="login-form" id="loginForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary"></div>
            <input type="hidden" name="tab" value="@tab" />
            
            <div class="form-group">
                <label class="form-label">@(tab == "staff" ? "WORK EMAIL / ACCOUNT" : "EMAIL / ACCOUNT")</label>
                <div class="input-wrapper">
                    <input asp-for="Email" class="form-input form-input-no-icon" placeholder="@(tab == "staff" ? "name@company.com" : "your@email.com")" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">SYSTEM PASSWORD</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" class="form-input form-input-no-icon" placeholder="Enter password" />
                    <button type="button" class="toggle-password" onclick="togglePassword()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                @if (tab == "staff")
                {
                    <a href="#" class="reset-link">RESET</a>
                }
            </div>

            <div class="form-group remember-me">
                <label>
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Remember me</span>
                </label>
            </div>

            <button type="submit" class="submit-btn">
                @(tab == "staff" ? "Access Staff Workspace" : "Access Customer Portal")
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </button>
        </form>

        @if (tab == "customer")
        {
            <div class="register-link">
                <span>Don't have an account?</span>
                <a asp-action="Register" asp-controller="Account">Create New Account</a>
            </div>
        }

        <div class="version-info">
            <span class="version-dot"></span>
            MOBILE SHOP PORTAL & SYSTEM V2.4
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const passwordInput = document.getElementById('Password');
        passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
    }

    function fillDemo(type) {
        const emailInput = document.getElementById('Email');
        const passwordInput = document.getElementById('Password');
        switch(type) {
            case 'admin':
                emailInput.value = 'tanvinislam3273@gmail.com';
                passwordInput.value = 'Tanvin0123!';
                break;
            case 'sales':
                emailInput.value = 'sales@mobileshop.com';
                passwordInput.value = 'Sales123!';
                break;
            case 'tech':
                emailInput.value = 'tech@mobileshop.com';
                passwordInput.value = 'Tech123!';
                break;
        }
    }
</script>
