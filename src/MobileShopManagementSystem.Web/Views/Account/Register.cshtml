@model MobileShopManagementSystem.Web.Models.RegisterViewModel
@{
    Layout = "_Layout";
}
<div class="login-wrapper">
    <div class="login-card">
    <div class="login-header">
        <a asp-action="Login" asp-controller="Account" asp-route-tab="customer" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12,19 5,12 12,5"/>
            </svg>
        </a>
        <div class="lock-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="8.5" cy="7" r="4"/>
                <line x1="20" y1="8" x2="20" y2="14"/>
                <line x1="23" y1="11" x2="17" y2="11"/>
            </svg>
        </div>
            <h2>Create Customer Account</h2>
            <p>Register to access order history, support &amp; service tracking</p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post" class="login-form" id="registerForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label class="form-label">FULL NAME</label>
                <div class="input-wrapper">
                    <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <input asp-for="FullName" class="form-input" placeholder="Enter your full name" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">EMAIL ADDRESS</label>
                <div class="input-wrapper">
                    <input asp-for="Email" class="form-input form-input-no-icon" placeholder="your@email.com" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">PHONE NUMBER</label>
                <div class="input-wrapper">
                    <input asp-for="Phone" class="form-input form-input-no-icon" placeholder="01XXXXXXXXX" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">PASSWORD</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" class="form-input form-input-no-icon" placeholder="Create a password" />
                    <button type="button" class="toggle-password" onclick="togglePassword()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">CONFIRM PASSWORD</label>
                <div class="input-wrapper">
                    <input asp-for="ConfirmPassword" type="password" class="form-input form-input-no-icon" placeholder="Repeat your password" />
                </div>
            </div>

            <button type="submit" class="submit-btn">
                Create Account
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </button>
        </form>

        <div class="version-info">
            <span class="version-dot"></span>
            MOBILE SHOP PORTAL &amp; SYSTEM V2.4
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const passwordInputs = document.querySelectorAll('input[type="password"]');
        passwordInputs.forEach(function(input) {
            input.type = input.type === 'password' ? 'text' : 'password';
        });
    }
</script>
