@{
    Layout = "_Layout";
}
<h2>Categories</h2>
<a class="btn" asp-action="Create">Add Category</a>
<table>
    <thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Name</td>
                <td>@cat.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cat.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" style="display:inline">
                        <button type="submit" onclick="return confirm('Delete?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
