@model MobileShopManagementSystem.Core.Models.Customer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Customer Details";
}
<div class="page-header">
    <h2><i class="bi bi-people me-2 text-primary"></i>Customer Details</h2>
</div>
<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3 text-muted">Name</dt><dd class="col-sm-9 fw-semibold">@Model.Name</dd>
            <dt class="col-sm-3 text-muted">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3 text-muted">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3 text-muted">Address</dt><dd class="col-sm-9">@Model.Address</dd>
        </dl>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>
</div>
