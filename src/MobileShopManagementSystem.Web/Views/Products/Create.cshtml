@model MobileShopManagementSystem.Core.Models.Product
@{
    Layout = "_Layout";
    var brands = ViewBag.Brands as IEnumerable<SelectListItem>;
    var categories = ViewBag.Categories as IEnumerable<SelectListItem>;
}
<h2>Create Product</h2>
<form asp-action="Create" method="post">
    <input asp-for="Name" placeholder="Product Name" />
    <input asp-for="Description" placeholder="Description" />
    <input asp-for="Price" placeholder="Price" type="number" step="0.01" />
    <input asp-for="StockQuantity" placeholder="Stock Quantity" type="number" />
    <input asp-for="ImageUrl" placeholder="Image URL" />
    <select asp-for="BrandId" asp-items="brands"><option value="">Select Brand</option></select>
    <select asp-for="CategoryId" asp-items="categories"><option value="">Select Category</option></select>
    <button type="submit">Save</button>
</form>
