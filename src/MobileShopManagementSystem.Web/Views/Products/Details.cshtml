@model MobileShopManagementSystem.Core.Models.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Product Details";
}
<div class="page-header">
    <h2><i class="bi bi-box-seam me-2 text-primary"></i>Product Details</h2>
</div>
<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3 text-muted">Name</dt><dd class="col-sm-9 fw-semibold">@Model.Name</dd>
            <dt class="col-sm-3 text-muted">Description</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3 text-muted">Price</dt><dd class="col-sm-9">@Model.Price.ToString("C")</dd>
            <dt class="col-sm-3 text-muted">Stock</dt><dd class="col-sm-9">@Model.StockQuantity</dd>
            <dt class="col-sm-3 text-muted">Brand</dt><dd class="col-sm-9">@Model.Brand?.Name</dd>
            <dt class="col-sm-3 text-muted">Category</dt><dd class="col-sm-9">@Model.Category?.Name</dd>
        </dl>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>
</div>
