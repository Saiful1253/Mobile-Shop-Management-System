@{
    Layout = "_Layout";
}
<h2>Products</h2>
<a class="btn" asp-action="Create">Add Product</a>
<table>
    <thead><tr><th>Name</th><th>Price</th><th>Stock</th><th>Brand</th><th>Category</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.StockQuantity</td>
                <td>@p.Brand?.Name</td>
                <td>@p.Category?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline">
                        <button type="submit" onclick="return confirm('Delete?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
