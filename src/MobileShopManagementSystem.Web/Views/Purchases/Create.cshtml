@model MobileShopManagementSystem.Core.Models.Purchase
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "New Purchase";
}
<div class="page-header">
    <h2><i class="bi bi-cart-plus me-2 text-primary"></i>New Purchase</h2>
</div>
<div class="card" style="max-width: 600px;">
    <div class="card-body">
        @using (Html.BeginForm("Create", "Purchases", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Supplier</label>
                <select class="form-select"><option>Select supplier...</option></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Product</label>
                <select class="form-select"><option>Select product...</option></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" value="1" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
            </div>
        }
    </div>
</div>
