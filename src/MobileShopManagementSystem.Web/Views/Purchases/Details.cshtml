@model MobileShopManagementSystem.Core.Models.Purchase
@{
    Layout = "_Layout";
}
<h2>Purchase Details</h2>
<p>Date: @Model.PurchaseDate.ToShortDateString()</p>
<p>Supplier: @Model.Supplier?.Name</p>
<p>Total: @Model.TotalAmount</p>
<table>
    <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th></tr></thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr><td>@item.Product?.Name</td><td>@item.Quantity</td><td>@item.UnitPrice</td></tr>
        }
    </tbody>
</table>
