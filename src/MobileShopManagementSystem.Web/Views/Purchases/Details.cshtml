@model MobileShopManagementSystem.Core.Models.Purchase
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Purchase Details";
}
<div class="page-header">
    <h2><i class="bi bi-cart-plus me-2 text-primary"></i>Purchase Details</h2>
</div>
<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3 text-muted">Date</dt><dd class="col-sm-9">@Model.PurchaseDate.ToString("dd MMMM yyyy")</dd>
            <dt class="col-sm-3 text-muted">Supplier</dt><dd class="col-sm-9">@Model.Supplier?.Name</dd>
            <dt class="col-sm-3 text-muted">Total</dt><dd class="col-sm-9 fw-semibold">@Model.TotalAmount.ToString("C")</dd>
        </dl>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>
