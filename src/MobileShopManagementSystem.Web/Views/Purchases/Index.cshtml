@{
    Layout = "_Layout";
}
<h2>Purchases</h2>
<a class="btn" asp-action="Create">Record Purchase</a>
<table>
    <thead><tr><th>Date</th><th>Supplier</th><th>Total Amount</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PurchaseDate.ToShortDateString()</td>
                <td>@p.Supplier?.Name</td>
                <td>@p.TotalAmount</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
