@{
    Layout = "_Layout";
}
<h2>Inventory Report</h2>
<table>
    <thead><tr><th>Name</th><th>Brand</th><th>Category</th><th>Price</th><th>Stock</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Brand?.Name</td>
                <td>@p.Category?.Name</td>
                <td>@p.Price</td>
                <td>@p.StockQuantity</td>
            </tr>
        }
    </tbody>
</table>
