@{
    Layout = "_Layout";
}
<h2>Purchase Report</h2>
<table>
    <thead><tr><th>Date</th><th>Supplier</th><th>Total Amount</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PurchaseDate.ToShortDateString()</td>
                <td>@p.Supplier?.Name</td>
                <td>@p.TotalAmount</td>
            </tr>
        }
    </tbody>
</table>
