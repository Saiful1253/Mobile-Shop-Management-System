@{
    Layout = "_Layout";
}
<h2>Sales Report</h2>
<table>
    <thead><tr><th>Date</th><th>Customer</th><th>Total Amount</th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SaleDate.ToShortDateString()</td>
                <td>@s.Customer?.Name</td>
                <td>@s.TotalAmount</td>
            </tr>
        }
    </tbody>
</table>
