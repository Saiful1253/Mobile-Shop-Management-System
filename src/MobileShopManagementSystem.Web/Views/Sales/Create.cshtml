@model MobileShopManagementSystem.Core.Models.Sale
@{
    Layout = "_Layout";
}
<h2>Record Sale</h2>
<form asp-action="Create" method="post">
    <select asp-for="CustomerId" asp-items="ViewBag.Customers"><option value="">Select Customer</option></select>
    <div id="items">
        <div class="item">
            <select name="Items[0].ProductId" asp-items="ViewBag.Products"><option value="">Select Product</option></select>
            <input name="Items[0].Quantity" placeholder="Qty" type="number" />
            <input name="Items[0].UnitPrice" placeholder="Unit Price" type="number" step="0.01" />
        </div>
    </div>
    <button type="submit">Save</button>
</form>
