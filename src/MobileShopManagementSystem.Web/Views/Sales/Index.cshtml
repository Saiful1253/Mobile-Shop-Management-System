@{
    Layout = "_Layout";
}
<h2>Sales</h2>
<a class="btn" asp-action="Create">Record Sale</a>
<table>
    <thead><tr><th>Date</th><th>Customer</th><th>Total Amount</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SaleDate.ToShortDateString()</td>
                <td>@s.Customer?.Name</td>
                <td>@s.TotalAmount</td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
