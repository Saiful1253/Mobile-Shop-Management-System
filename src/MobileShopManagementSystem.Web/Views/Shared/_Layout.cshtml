@using Microsoft.AspNetCore.Identity
@inject SignInManager<MobileShopManagementSystem.Core.Models.ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mobile Shop MS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @if (ViewData["HideLayout"] == null || !(ViewData["HideLayout"] is bool hideLayout) || !hideLayout)
    {
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-phone"></i> Mobile Shop MS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-box-seam"></i> Products</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="bi bi-box"></i> Products</a></li>
                                <li><a class="dropdown-item" asp-controller="Brands" asp-action="Index"><i class="bi bi-tags"></i> Brands</a></li>
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder"></i> Categories</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-arrow-left-right"></i> Transactions</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Sales" asp-action="Index"><i class="bi bi-cart-check"></i> Sales</a></li>
                                <li><a class="dropdown-item" asp-controller="Purchases" asp-action="Index"><i class="bi bi-cart-plus"></i> Purchases</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Suppliers</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-bar-chart"></i> Reports</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="SalesReport">Sales Report</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="PurchaseReport">Purchase Report</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="InventoryReport">Inventory Report</a></li>
                        </ul>
                    </li>
                </ul>
                </div>
            </div>
        </nav>

        <div class="d-flex">
            <nav id="sidebar" class="sidebar d-none d-md-block">
                <div class="sidebar-content">
                    <h6 class="sidebar-heading">Quick Links</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Create"><i class="bi bi-cart-plus"></i> New Sale</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Purchases" asp-action="Create"><i class="bi bi-bag"></i> New Purchase</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Create"><i class="bi bi-person-plus"></i> New Customer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-circle"></i> Add Product</a></li>
                    </ul>

                    <h6 class="sidebar-heading mt-4">Management</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" asp-controller="Brands" asp-action="Index"><i class="bi bi-tags"></i> Manage Brands</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder2"></i> Manage Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> Manage Products</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Manage Customers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Manage Suppliers</a></li>
                    </ul>

                    <div class="logout-section mt-auto">
                        <form id="logoutForm" action="/Account/LogOff" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                                <i class="bi bi-box-arrow-right"></i> Log out
                            </button>
                        </form>
                    </div>
                </div>
            </nav>
            <main class="flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <span class="text-muted"> Mobile Shop Management System &copy; @DateTime.Now.Year - All rights reserved.</span>
            </div>
        </footer>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
