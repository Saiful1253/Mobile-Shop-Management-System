@using Microsoft.AspNetCore.Identity
@inject SignInManager<MobileShopManagementSystem.Core.Models.ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle"></i> @User.Identity.Name
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <form asp-controller="Account" asp-action="LogOff" method="post" class="d-inline">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log off</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-person"></i> Login
        </a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-controller="Account" asp-action="AdminLogin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" asp-controller="Account" asp-action="CustomerLogin"><i class="bi bi-person me-2"></i>Customer</a></li>
        </ul>
    </li>
}
