@{
    Layout = "_Layout";
}
<h2>Suppliers</h2>
<a class="btn" asp-action="Create">Add Supplier</a>
<table>
    <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Phone</td>
                <td>@s.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline">
                        <button type="submit" onclick="return confirm('Delete?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
